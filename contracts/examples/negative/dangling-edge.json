      "rubricVersion": "order-payment:1"
    },
    "context": {
      "requirements": [
        {
          "id": "req-payment",
          "kind": "functional",
          "text": "После подтверждения оплаты обновить состояние существующего заказа и сохранить связь с платёжным событием.",
          "priority": "must",
          "diagramIds": [],
          "originTemplateObjectId": "tpl-req-payment"
        }
      ],
      "acceptanceCriteria": [
        {
          "id": "accept-no-duplicate-order",
          "text": "Повтор одного уведомления об оплате не создаёт второй оплаченный заказ.",
          "requirementRefs": [
            "req-payment"
          ],
          "priority": "must",
          "condition": {
            "kind": "scenario",
            "given": "Существует заказ и успешно обработанное уведомление с paymentEventId.",
            "when": "То же уведомление приходит повторно.",
            "then": "Состояние оплаты остаётся прежним, второй заказ и повторный эффект оплаты не создаются."
          },
          "verificationMethod": "Интеграционный тест с повторной и конкурентной доставкой одного paymentEventId.",
          "diagramIds": [],
          "originTemplateObjectId": "tpl-accept-no-duplicate-order"
        },
        {
          "id": "accept-payment-status",
          "text": "Не менее 99% принятых уведомлений обновляют статус заказа за 30 секунд в согласованных условиях приёмки.",
          "requirementRefs": [
            "req-payment"
          ],
          "priority": "must",
          "condition": {
            "kind": "numeric",
            "metricName": "Доля уведомлений с обновлением статуса заказа за 30 секунд",
            "comparator": "ge",
            "value": 99,
            "upperValue": null,
            "unit": "%",
            "measurementWindow": "Приёмочный прогон длительностью 1 час",
            "population": "Все валидные уведомления, принятые HTTP endpoint в этом прогоне"
          },
          "verificationMethod": "Сопоставить время приёма события и перехода заказа в оплаченный статус; профиль нагрузки требуется уточнить.",
          "diagramIds": [],
          "originTemplateObjectId": "tpl-accept-payment-status"
        }
      ],
      "technicalParameters": [],
      "assumptions": [
        {
          "id": "assumption-delivery",
          "text": "Платёжный провайдер может доставлять одно уведомление повторно.",
          "diagramIds": []
        }
      ],
      "constraints": []
    },
